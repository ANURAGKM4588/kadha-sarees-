# Server configuration
PORT=8000

# Supabase Credentials (Backend only - NEVER exposed to frontend or committed to git)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Razorpay Payment Gateway Credentials (Backend only - NEVER exposed to frontend or committed to git)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
